<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="JellyWindow" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/jelly_in</item>
        <item name="android:activityCloseExitAnimation">@anim/jelly_out</item>
        <item name="android:taskOpenEnterAnimation">@anim/jelly_in</item>
        <item name="android:taskCloseExitAnimation">@anim/jelly_out</item>
        <item name="android:taskToFrontEnterAnimation">@anim/jelly_in</item>
        <item name="android:taskToBackExitAnimation">@anim/jelly_out</item>
    </style>

    <style name="AppTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/boot_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/JellyWindow</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
    </style>

    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/boot_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
